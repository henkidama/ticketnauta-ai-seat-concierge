# Copy this file to .env and choose local-only values. Never commit .env.
# Existing test PostgreSQL or the optional `localdb` Compose profile.
DB_HOST=your_postgres_host
DB_PORT=5432
DB_NAME=your_demo_database
DB_USER=your_demo_user
DB_PASSWORD=choose_a_long_random_password
DB_SSL_MODE=Prefer

# Only used by the optional local PostgreSQL container.
LOCAL_POSTGRES_PORT=5435

APP_PORT=8085
HOLD_MINUTES=10
DEMO_ADMIN_TOKEN=choose_a_separate_long_random_token

# Optional: only needed with `docker compose --profile tunnel up -d`.
CLOUDFLARE_TUNNEL_TOKEN=
